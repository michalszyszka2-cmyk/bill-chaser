# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# video explainer build artefacts (regenerate with video/render.py)
video/frames/
video/seg/
video/preview/
video/*.log

# video-howto build artefacts (same as video/)
video-howto/frames/
video-howto/seg/
video-howto/preview/
video-howto/check/
video-howto/*.log

# video source folders stay out of git (Quietside consistency job, 29 Oct 2026)
video/
video-howto/
